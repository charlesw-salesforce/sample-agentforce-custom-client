# Server Configuration
PORT=8080                          # Port to listen on (default: 8080)
HOST=127.0.0.1                     # Host to bind to (default: 127.0.0.1 in dev, 0.0.0.0 in prod)
NODE_ENV=development               # Environment (development/production)
ALLOWED_ORIGIN=http://localhost:5173  # CORS allowed origin

# Salesforce Configuration
SALESFORCE_BASE_URL=              # Salesforce SCRT URL
SALESFORCE_ORG_ID=                # Salesforce Organization ID
SALESFORCE_DEVELOPER_NAME=         # Salesforce Developer Name